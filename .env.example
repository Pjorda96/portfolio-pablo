# Copia este archivo a .env.local y rellena los valores.
# Nunca subas valores reales al repositorio.

# Origen canónico del sitio. Obligatorio en producción;
# en desarrollo se usa http://localhost:3000 si se deja vacío.
SITE_URL=http://localhost:3000

# --- Próximas fases (aún no se usan) ---

# Formulario de contacto (Resend) — F3
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=

# Asistente IA (Anthropic) — F4
# ANTHROPIC_API_KEY=

# Anti-spam (Cloudflare Turnstile) — F3
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
