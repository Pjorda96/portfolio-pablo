# Copia este archivo a .env.local y rellena los valores.
# Nunca subas valores reales al repositorio.

# Origen canónico del sitio. Obligatorio en producción;
# en desarrollo se usa http://localhost:3000 si se deja vacío.
SITE_URL=http://localhost:3000

# --- Formulario de contacto (Resend) — F3 ---
# Todas opcionales. Sin RESEND_API_KEY, en desarrollo el mensaje se escribe en
# la consola del servidor y el formulario responde «enviado»; en producción el
# formulario muestra «no disponible temporalmente».

# Clave de API de Resend (empieza por re_).
RESEND_API_KEY=
# Remitente. Hasta verificar el dominio en Resend usa su remitente de pruebas
# (por defecto: Web pablojorda.es <onboarding@resend.dev>, que solo entrega
# al correo de la cuenta de Resend).
CONTACT_FROM_EMAIL=
# Buzón que recibe los mensajes (por defecto, el correo de src/content/owner.ts).
CONTACT_TO_EMAIL=
# Secreto (≥ 16 caracteres) para firmar la marca de tiempo antispam del
# formulario. Si se deja vacío se deriva de RESEND_API_KEY.
CONTACT_FORM_SECRET=

# --- Próximas fases (aún no se usan) ---

# Asistente IA (Anthropic) — F4
# ANTHROPIC_API_KEY=

# Anti-spam (Cloudflare Turnstile) — F3
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
