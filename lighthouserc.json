{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3400",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3400/",
        "http://localhost:3400/sobre-mi",
        "http://localhost:3400/servicios/soluciones-ia",
        "http://localhost:3400/en"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance"],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 300 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 225000 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 130000 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 425000 }]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "largest-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.01 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
            "categories:performance": ["warn", { "minScore": 0.9 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
